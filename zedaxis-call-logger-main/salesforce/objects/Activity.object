<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Call_Number__c</fullName>
        <description>Outside number of a CallSwitch call, national digits (e.g. 7424405482). Set by zedaxis-call-logger; used to match call recordings to their Task.</description>
        <externalId>false</externalId>
        <label>Call Number</label>
        <length>20</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Call_Started__c</fullName>
        <description>When the CallSwitch call started. Set by zedaxis-call-logger; used to match call recordings to their Task.</description>
        <externalId>false</externalId>
        <label>Call Started</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
</CustomObject>
